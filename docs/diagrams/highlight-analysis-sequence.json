  "cards": [
    {
      "dot": "cyan",
      "title": "两个 Agent，一次冻结",
      "items": [
        "候选发现按源视频分批调用，每批 ≤6000 字符、重叠 2 句",
        "全局评分只接收已校验候选，不新增候选、不改时间与句段 ID",
        "模型与地址在运行开始前解析一次并冻结，两阶段必须同模型",
        "UI 通过 ai_get_highlight_progress 轮询读取运行终态与 Token 用量"
      ]
    },
    {
      "dot": "rose",
      "title": "本地校验是信任边界",
      "items": [
        "跨源视频、越界时间、伪造句段 ID、时长不在 15–90 秒一律丢弃",
        "模型返回的文本被视为用户数据，不是可执行指令",
        "候选通过校验前不会进入仓库，也不会参与评分"
      ]
    },
    {
      "dot": "emerald",
      "title": "失败可续、结果可复现",
      "items": [
        "批级状态落库，同一 run_id 只跑一次，失败批次可单独重跑",
        "运行指纹含调用路径指纹，同输入同模型直接复用已有运行",
        "连续 3 批失败熔断；评分失败退回备用排序并标记 partial"
      ]
    }
  ]
